{
  "name": "eurojob-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "profile:build": "node --experimental-strip-types scripts/build-profile.ts",
    "jobs:collect": "node --experimental-strip-types scripts/collect.ts",
    "jobs:match": "node --experimental-strip-types scripts/match.ts",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "test:all": "node --test --experimental-strip-types \"test/*.test.ts\" \"test/integration/*.test.ts\"",
    "jobs:analyse": "node --experimental-strip-types scripts/analyse.ts",
    "sync": "node --experimental-strip-types scripts/sync.ts",
    "user:password": "node --experimental-strip-types scripts/set-password.ts",
    "db:copy": "node --experimental-strip-types scripts/copy-to-remote.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.0.0",
    "dotenv": "^16.4.5",
    "jose": "^5.9.6",
    "next": "^15.1.0",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  },
  "type": "module",
  "description": "Personal European job-search assistant: collects real postings, scores them against your resume with explainable arithmetic, and writes tailored resumes and cover letters that cannot claim anything unevidenced.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
