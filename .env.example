# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Use 127.0.0.1 rather than localhost: on Windows, localhost often resolves to
# ::1 first, which may carry a different pg_hba.conf rule than IPv4 loopback.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=eurojob
PGUSER=postgres
PGPASSWORD=

# ---------------------------------------------------------------------------
# AI (required for match explanations, resume tailoring, cover letters)
# Console: https://platform.claude.com  ->  API keys
# Pricing: Claude Opus 5 is $5 / 1M input tokens, $25 / 1M output.
# Caching + the ai_cache table mean a given job description is only ever sent
# once, so a realistic weekly run is cents, not dollars.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Only jobs scoring at or above this are sent to the AI at all (spec §19).
AI_MIN_SCORE=70

# ---------------------------------------------------------------------------
# Job sources
# ---------------------------------------------------------------------------
# Arbeitnow needs no credentials and is enabled by default.
#
# Adzuna (optional, free tier): broad European coverage incl. DE/NL/FR/AT/CH/PL/IT/ES/GB.
# Register at https://developer.adzuna.com to get both values.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
