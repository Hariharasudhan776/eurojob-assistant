# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local PostgreSQL. Use 127.0.0.1 rather than localhost: on Windows, localhost
# often resolves to ::1 first, which may carry a different pg_hba.conf rule than
# IPv4 loopback.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=eurojob
PGUSER=postgres
PGPASSWORD=

# A managed database instead (Neon, Supabase, RDS). When this is set it WINS over
# the PG* variables above, and TLS is required unless the host is loopback.
# Neon gives you this string in its dashboard; use the POOLED endpoint
# (-pooler in the hostname) for a serverless deployment.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/eurojob?sslmode=require

# Where `npm run db:copy` should copy your local data to. Falls back to
# DATABASE_URL if unset.
# TARGET_DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production a missing or short secret is a hard startup error, because a
# predictable key lets anyone mint a session for any account.
SESSION_SECRET=

# The identity the CLI scripts use (npm run sync, npm run db:migrate). It is not
# a way to sign in: the row it creates has no usable password until you set one
# with `npm run user:password -- <email> "<password>"`.
APP_USER_EMAIL=local@eurojob

# ---------------------------------------------------------------------------
# AI (required for match explanations, resume tailoring, cover letters)
# Console: https://platform.claude.com  ->  API keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only jobs scoring at or above this are sent to the AI at all.
AI_MIN_SCORE=70

# Spend caps, all checked BEFORE a request is sent. The daily cap is PER USER:
# every account gets its own allowance, so nobody can spend anyone else's.
AI_MAX_RUN_USD=0.50
AI_MAX_DAILY_USD=2.00
AI_MAX_CALL_USD=0.35

# Where cached AI answers live: `file` (data/ai-cache) or `db` (the ai_cache
# table). Left unset it picks the database on a serverless host, where the
# filesystem does not survive the request, and the disk locally.
# AI_CACHE=

# ---------------------------------------------------------------------------
# Job sources
# ---------------------------------------------------------------------------
# Arbeitnow, The Muse and Jobicy need no credentials and are enabled by default.
# The Muse is what covers IRELAND, which Adzuna does not serve at all.
# Jobicy is what covers worldwide REMOTE roles -- the only category for which an
# employer's country is not a visa question.
#
# Adzuna (optional, free): 21 country endpoints -- GB DE NL FR PL AT BE CH IT ES
# US CA AU NZ ZA SG IN BR MX RU AR. Register at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Pages per country per run, 50 results each. Three is ~63 requests plus a
# ~16-request sweep of two extra categories in the priority countries, well
# inside the free tier's 250/day. Set it to 10 for a one-off deep backfill of
# everything posted in the last 30 days, then put it back -- a daily run only
# has to keep up with a day of new postings.
# ADZUNA_MAX_PAGES=3

# Optional: raises The Muse's rate limit. It works without one.
# MUSE_API_KEY=
# Semicolon-separated "City, Country" list, overriding the default (Irish cities
# first, then the Nordics).
# MUSE_LOCATIONS=Dublin, Ireland;Cork, Ireland;London, United Kingdom
# Pages per location. The location parameter is a weak filter, so the local
# postings this source exists to find are spread through the pages rather than
# concentrated on the first two.
# MUSE_MAX_PAGES=4

# How many jobs one sync collects in total, across all sources. This is a cap on
# ROWS, not on requests -- each source paces itself and caps its own pages, which
# is what actually protects the APIs. It was 600, which silently threw away 40%
# of every Adzuna page the app had already paid to fetch.
# JOB_COLLECTION_LIMIT=5000

# How many days a posting is presumed open after the last evidence that it was.
# Must stay comfortably above the 30-day collection window: a live posting can go
# 30 days without being returned purely because it aged out of the SEARCH.
# JOB_STALE_AFTER_DAYS=45
# How many jobs one scoring request handles before reporting what is left.
# RESCORE_BATCH=400
